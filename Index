<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Pase Fan · Sucursales y retos</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root {
  --red:#e4002b;
  --black:#111111;
  --cream:#f6f1e8;
  --muted:#5f5b56;
  --line:#e6ddd2;
  --white:#ffffff;
}
* { box-sizing:border-box; }
html,body { margin:0; padding:0; background:transparent; font-family:Arial,Helvetica,sans-serif; color:var(--black); }
.section { width:100%; max-width:1200px; margin:0 auto; background:transparent; }
.head { margin-bottom:14px; }
.kicker { font-size:11px; font-weight:900; letter-spacing:.16em; text-transform:uppercase; color:var(--red); margin-bottom:6px; }
.title { margin:0; font-size:clamp(26px, 4vw, 40px); line-height:1.0; font-weight:900; }
.sub { margin:8px 0 0; font-size:14px; line-height:1.45; color:var(--muted); max-width:680px; }
#map-wrap { position:relative; border-radius:22px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,.08); border:1px solid var(--line); }
#map { width:100%; height:560px; background:#eee; }
.floating-note { position:absolute; top:14px; left:14px; z-index:500; background:rgba(17,17,17,.88); color:#fff; border-radius:999px; padding:9px 13px; font-size:11px; font-weight:800; letter-spacing:.05em; }
.legend { margin-top:12px; display:flex; flex-wrap:wrap; gap:10px; color:var(--muted); font-size:12px; align-items:center; }
.legend-pill { display:inline-flex; align-items:center; gap:7px; background:#fff; border:1px solid var(--line); border-radius:999px; padding:7px 10px; }
.legend-dot { width:10px; height:10px; border-radius:50%; background:var(--red); display:inline-block; }
.leaflet-popup-content-wrapper { padding:0; border-radius:18px; box-shadow:0 14px 36px rgba(0,0,0,.18); }
.leaflet-popup-content { margin:0; width:285px !important; }
.popup { padding:16px; background:#fff; }
.popup-kicker { font-size:10px; color:var(--red); font-weight:900; letter-spacing:.14em; text-transform:uppercase; margin-bottom:6px; }
.popup-title { margin:0; font-size:20px; line-height:1.05; font-weight:900; color:var(--black); }
.popup-card { margin-top:12px; background:var(--cream); border:1px solid var(--line); border-radius:14px; padding:11px 12px; }
.popup-card strong { display:block; font-size:10px; line-height:1; text-transform:uppercase; letter-spacing:.12em; margin-bottom:6px; color:var(--black); }
.popup-card span { font-size:13px; line-height:1.35; color:var(--muted); }
.popup-actions { margin-top:12px; display:grid; grid-template-columns:1fr; gap:8px; }
.btn { min-height:42px; display:flex; align-items:center; justify-content:center; border-radius:12px; text-decoration:none; font-size:12px; font-weight:900; letter-spacing:.02em; }
.btn-primary { background:var(--red); color:#fff; }
.btn-secondary { background:#fff; color:var(--black); border:1px solid var(--line); }
@media (max-width: 700px) {
  #map { height:480px; }
  .popup-title { font-size:18px; }
}
</style>
</head>
<body>
<section class="section">
  <div class="head">
    <div class="kicker">KFC × Soles · Pase Fan</div>
    <h2 class="title">Sucursales y retos</h2>
    <p class="sub">Toca un pin para conocer el reto de cada sucursal y usa el botón para abrir la ruta en Google Maps.</p>
  </div>
  <div id="map-wrap">
    <div class="floating-note">5 SUCURSALES PARTICIPANTES</div>
    <div id="map" aria-label="Mapa de sucursales Pase Fan"></div>
  </div>
  <div class="legend">
    <span class="legend-pill"><span class="legend-dot"></span> Pin personalizado Pase Fan</span>
    <span class="legend-pill">Cada pin muestra sucursal + reto + botón de ruta</span>
  </div>
</section>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const stores = [{"name": "KFC Justo Sierra", "challenge": "Reto predicción", "lat": 32.6400005, "lng": -115.4498868}, {"name": "KFC Nuevo Mexicalli", "challenge": "Reto Fan Soles", "lat": 32.6101351, "lng": -115.3869803}, {"name": "KFC Anáhuac", "challenge": "Reto Redes sociales", "lat": 32.6098673, "lng": -115.4795189}, {"name": "KFC Santiago Vidaurri", "challenge": "Reto Visita KFC", "lat": 32.5859059, "lng": -115.4348268}, {"name": "KFC Lázaro Cárdenas", "challenge": "Reto Mensaje a los Soles", "lat": 32.6233811, "lng": -115.4966145}];
const map = L.map('map', { scrollWheelZoom:false, zoomControl:true });
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  maxZoom:19,
  attribution:'&copy; OpenStreetMap'
}).addTo(map);

const pinIcon = L.icon({
  iconUrl: 'data:image/png;base64,',
  iconSize: [52, 76],
  iconAnchor: [26, 70],
  popupAnchor: [0, -64]
});

const bounds = [];
stores.forEach((store, index) => {
  const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${store.lat},${store.lng}`;
  const popup = `
    <div class="popup">
      <div class="popup-kicker">Sucursal ${index+1}</div>
      <h3 class="popup-title">${store.name}</h3>
      <div class="popup-card">
        <strong>Reto</strong>
        <span>${store.challenge}</span>
      </div>
      <div class="popup-actions">
        <a class="btn btn-primary" href="${mapsUrl}" target="_blank" rel="noopener">CÓMO LLEGAR</a>
      </div>
    </div>`;
  L.marker([store.lat, store.lng], { icon: pinIcon, title: store.name })
    .addTo(map)
    .bindPopup(popup);
  bounds.push([store.lat, store.lng]);
});
map.fitBounds(bounds, { padding:[40,40] });
</script>
</body>
</html>
